{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".dependency-cruiser.cjs"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!test/**"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "depcruise": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "verify-vendor": {
      "inputs": ["vendor/**", "scripts/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#format:check": {}
  }
}
