#!/usr/bin/env bash
# Runs the CI quality gates on the affected packages before every push.
# Skip it in an emergency with: git push --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1

# Git hooks run with a minimal PATH: load nvm when node is not on it.
if ! command -v node >/dev/null 2>&1 && [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
  . "${NVM_DIR:-$HOME/.nvm}/nvm.sh" >/dev/null 2>&1
  nvm use --silent >/dev/null 2>&1
fi
command -v node >/dev/null 2>&1 || { echo "verify FAIL: node not found on PATH" >&2; exit 1; }

# turbo runs each task through pnpm, so a working pnpm must be on PATH. When it is missing or
# broken (e.g. a stale corepack shim), expose the pinned version from package.json through npx.
if ! pnpm --version >/dev/null 2>&1; then
  version=$(node -p "require('./package.json').packageManager.split('@')[1].split('+')[0]") || exit 1
  shim_dir=$(mktemp -d) || exit 1
  trap 'rm -rf "$shim_dir"' EXIT
  printf '#!/bin/sh\nexec npx -y "pnpm@%s" "$@"\n' "$version" > "$shim_dir/pnpm"
  chmod +x "$shim_dir/pnpm"
  PATH="$shim_dir:$PATH"
  export PATH
fi

pnpm --loglevel silent verify
